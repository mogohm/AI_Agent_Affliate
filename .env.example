# ─────────────────────────────────────────────────────────────────────────────
# AI Affiliate Studio — environment variables
# Copy to `.env.local` (Next.js) / export in your worker environment.
# NEVER commit real secrets. All keys stay server-side; nothing here is exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the web app (used for secure cookies when https)
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (default): embedded PostgreSQL (PGlite) stored on disk, migrations auto-applied.
DATABASE_URL=pglite://./.data/pglite
# Production: Neon PostgreSQL (pooled connection string), then run `npm run db:migrate`.
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Apply migrations automatically on first connection (otherwise run `npm run db:migrate` in CI/CD)
DB_AUTO_MIGRATE=false
DB_POOL_MAX=5

# ── Auth & encryption ────────────────────────────────────────────────────────
# REQUIRED in production: random string ≥ 32 chars (e.g. `openssl rand -base64 48`)
AUTH_SECRET=
# Optional: key for encrypting stored API keys/credentials (32-byte base64 or 64 hex). Defaults to a key derived from AUTH_SECRET.
APP_ENCRYPTION_KEY=

# First-run bootstrap (creates the workspace + admin when the users table is empty)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
# Seed clearly-labelled DEMO products/orders (set false for production)
SEED_DEMO_DATA=true

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Without a key the app runs in Demo Mode (deterministic generators, no paid calls).
# A key can also be set per workspace in Settings → AI Providers (stored encrypted).
# Live calls only happen after an admin switches AI mode to "Live" in Settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Default model ids (editable in Settings) — verify availability/pricing for your account.
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VIDEO_MODEL=sora-2

# ── Job queue / worker ───────────────────────────────────────────────────────
# db     = Postgres-backed durable queue (default, no Redis needed)
# bullmq = Postgres stays the source of truth; Redis/BullMQ adds instant wake-ups
QUEUE_DRIVER=db
REDIS_URL=
# Run the worker inside the Next.js server process (default true for PGlite dev).
# Production on Vercel: WORKER_INLINE=false and run `npm run worker` on a VPS/container.
WORKER_INLINE=
WORKER_CONCURRENCY=1

# ── Object storage ───────────────────────────────────────────────────────────
# local = files under LOCAL_STORAGE_DIR (single host). Use s3 when web and worker run on different hosts.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/storage
# S3-compatible (Cloudflare R2 / AWS S3 / MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Rendering ────────────────────────────────────────────────────────────────
# FFmpeg binary (defaults to the bundled ffmpeg-static)
FFMPEG_PATH=
# Output resolution (9:16) and frame rate. 1080x1920 for final quality; 720x1280 is faster.
RENDER_WIDTH=720
RENDER_HEIGHT=1280
RENDER_FPS=30
